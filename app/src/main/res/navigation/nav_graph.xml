<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/main_menu_button">

    <fragment
        android:id="@+id/main_menu_button"
        android:name="app.dll.test.presentation.activity.MainMenuButtonFragment"
        android:label="fragment_main_menu_button"
        tools:layout="@layout/fragment_main_menu_button">

        <action
            android:id="@+id/action_main_menu_button_to_blessings_fragment"
            app:destination="@id/blessings_fragment"
            app:popUpTo="@+id/main_menu_button"
            app:popUpToInclusive="true"/>

        <action
            android:id="@+id/action_main_menu_button_to_textPrayers_fragment"
            app:destination="@id/textPrayers_fragment"
            app:popUpTo="@+id/main_menu_button"
            app:popUpToInclusive="true"/>

        <action
            android:id="@+id/action_main_menu_button_to_tehillim_fragment"
            app:destination="@id/tehillim_fragment"
            app:popUpTo="@+id/main_menu_button"
            app:popUpToInclusive="true"/>

        <action
            android:id="@+id/action_main_menu_button_to_timetable_fragment"
            app:destination="@id/timetable_fragment"
            app:popUpTo="@+id/main_menu_button"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/blessings_fragment"
        android:name="app.dll.test.presentation.buttonsFragments.BlessingsFragment"
        android:label="fragment_blessings"
        tools:layout="@layout/fragment_blessings" />
    <fragment
        android:id="@+id/textPrayers_fragment"
        android:name="app.dll.test.presentation.buttonsFragments.TextPrayersFragment"
        android:label="fragment_text_prayers"
        tools:layout="@layout/fragment_text_prayers" />
    <fragment
        android:id="@+id/tehillim_fragment"
        android:name="app.dll.test.presentation.buttonsFragments.TehillimFragment"
        android:label="fragment_tehillim"
        tools:layout="@layout/fragment_tehillim">
        <action
            android:id="@+id/action_tehillim_fragment_to_daily_tehillim_fragment"
            app:destination="@id/dailyTehillimFragment"
            app:popUpTo="@+id/tehillim_fragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_tehillim_fragment_to_allTehillimFragment"
            app:destination="@id/allTehillimFragment" />
    </fragment>
    <fragment
        android:id="@+id/timetable_fragment"
        android:name="app.dll.test.presentation.buttonsFragments.TimetableFragment"
        android:label="fragment_timetable"
        tools:layout="@layout/fragment_timetable">
        <argument
            android:name="day"
            app:argType="string"/>
        <action
            android:id="@+id/action_timetable_fragment_to_main_menu_button"
            app:destination="@id/main_menu_button"
            app:popUpTo="@+id/main_menu_button"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_to_dalyZamanimFragment"
            app:destination="@id/dalyZamanimFragment"
            app:popUpTo="@id/timetable_fragment"
            app:popUpToInclusive="true"/>


    </fragment>
    <fragment
        android:id="@+id/dalyZamanimFragment"
        android:name="app.dll.test.presentation.buttonsFragments.subFragments.DailyZamanimFragment"
        android:label="fragment_daly_zamanim"
        tools:layout="@layout/fragment_daly_zamanim">

        <action
            android:id="@+id/action_dailyZmanim_to_timetable"
            app:destination="@id/timetable_fragment"
            app:popUpTo="@id/dalyZamanimFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/dailyTehillimFragment"
        android:name="app.dll.test.presentation.buttonsFragments.subFragments.tehillim.DailyTehillimFragment"
        android:label="fragment_daily_tehillim"
        tools:layout="@layout/fragment_daily_tehillim" />
    <fragment
        android:id="@+id/allTehillimFragment"
        android:name="app.dll.test.presentation.buttonsFragments.subFragments.tehillim.AllTehillimFragment"
        android:label="AllTehillimFragment" />
</navigation>
